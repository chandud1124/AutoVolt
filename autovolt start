# ==============================================================================
# COMMON ISSUES & SOLUTIONS
# ==============================================================================

# Issue: Port already in use
# Solution: Find and kill process using the port
netstat -ano | findstr :3001
taskkill /PID <PID> /F

# Issue: MongoDB connection failed
# Solution: Check MongoDB is running and connection string is correct
docker ps | grep mongo
# Or: mongosh --eval "db.adminCommand('ping')"

# Issue: ESP32 not connecting
# Solution: Check WiFi credentials, MQTT broker, and device registration

# Issue: Frontend not loading
# Solution: Check backend is running and API_BASE_URL is correct in .env

# Issue: AI/ML service errors
# Solution: Check Python dependencies and port 8002 availability
pip install -r ai_ml_service/requirements.txt

